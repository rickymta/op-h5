# Copy thanh .env roi dien. KHONG commit .env (da gitignore).
# Dung cho CA HAI phuong an: docker-compose.yml (bind mount) va docker-compose.image.yml (pull image).

# ---------------------------------------------------------------- host cong khai
# IP hoac domain ma NGUOI CHOI truy cap (khong scheme). Duoc dien vao global.conf.json
# (server bao client dia chi login/stat/pay/world) va bundle client.
PUBLIC_HOST=

# ---------------------------------------------------------------- secrets server Java
# Tu chon (khong can khop server cu): initdb/mysql/zz-init.sh ghi 3 mat khau nay vao tcg.cloud_*
# luc MySQL khoi tao lan dau — ke ca khi import dump that. Nhanh nhat: ./gen-env.sh <PUBLIC_HOST>.
TCG_SECRET=                 # tcg.secret dung chung moi service Java + Adapter (goc: env.yml)
MYSQL_ROOT_PASSWORD=
MONGO_USER=abc123
MONGO_PASSWORD=
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# ---------------------------------------------------------------- secrets website (PHP)
CONSOLE_ADMIN_PASSWORD=     # mat khau tai khoan `admin` cua console :9999 — zz-init.sh ghi vao tcg.staff; PHP GM tool + Adapter dung
WEB_DB_PASSWORD_REV=        # mat khau PDO rieng cua adminphp@2024/rev.php + user/indexapk.php (de trong = dung MYSQL_ROOT_PASSWORD)
THESIEUTOC_API_KEY=         # api/card.php
MOMO_CALLBACK_SIGNATURE=    # api/momoCallback.php
REV_QUERY_KEY=              # adminphp@2024/rev.php?key=
GM_CODE=                    # gm/config.php $gmcode
GMHANGLONG_CODE=            # gmhanglong/config/config.php $gm_code
GM_LOGIN_TOKEN=             # gm/user/function/common.php (JWT; lay moi qua POST /staff/login)
MOMO_PHONE=                 # so nhan MoMo trong link QR (user/naptien*.php)
BANK_CALLBACK_CHECKSUM=     # checksum callback ngan hang (api/bankCallback.php); gia tri cu da lo, xin cap moi

# ---------------------------------------------------------------- duong dan / image
# Phuong an 1 (bind mount): cay server/ va website/ tren host
SERVER_DIR=../server
WEBSITE_DIR=../website
# Phuong an 2 (image): thu muc chua res/ sound/ spine/ (upload 1 lan bang WinSCP)
ASSETS_DIR=/opt/tcg/assets
IMAGE_SERVER=ghcr.io/rickymta/op-h5-server:latest
IMAGE_PHP=ghcr.io/rickymta/op-h5-php:latest
IMAGE_NGINX=ghcr.io/rickymta/op-h5-nginx:latest
IMAGE_ID=ghcr.io/rickymta/op-h5-id:latest
IMAGE_ADAPTER=ghcr.io/rickymta/op-h5-adapter:latest
IMAGE_ADMIN=ghcr.io/rickymta/op-h5-admin:latest

# ---------------------------------------------------------------- game
GAME_SRV_CODE=s1

# ---------------------------------------------------------------- heap (may 8 GB; tong mac dinh 4992m)
JAVA_XMX_CONSOLE=512m
JAVA_XMX_WORLD=640m
JAVA_XMX_META=320m
JAVA_XMX_STATISTIC=512m
JAVA_XMX_PAY=384m
JAVA_XMX_GROUP=640m
JAVA_XMX_GAME=1024m
JAVA_XMX_LOGIN=320m
JAVA_XMX_CROSS=640m

# ---------------------------------------------------------------- doi game server
# srvCode:wsPort:deviceCode, cach nhau bang dau phay. HTTP noi bo cua moi tien trinh
# game LUON la wsPort + 10000, nen dung dat wsPort cua server nay trung HTTP cua server kia.
# Sua xong chay: ./gen-game-servers.sh --write
# Moi game server them ~1,2 GB RAM — may 8 GB chi vua MOT server cung ha tang.
# zz-init.sh (lan khoi tao MySQL dau) tu them dong tcg.srv_game + srv_game_access + cloud_device cho
# tung muc o day (copy dong s1); platform-seed doc lai tu tcg.srv_game.
GAME_SERVERS=s1:8001:d1     # s1, wsPort 8001, device_code d1 (khop dong s1 trong seed / dump cu)

# ---------------------------------------------------------------- nen tang (platform/)
# Ba dich vu Go: id :8080 (OIDC, danh tinh, vi Xu — CONG KHAI, mo port 8080), adapter :8090
# (chi loopback, nginx proxy / /may-chu /quy-doi /choi-game /auth/ /api/game/), admin :8100
# (chi loopback, vao qua SSH tunnel). Service platform-seed tu tao DB `platform` va seed du lieu.
ID_ISSUER=                  # URL cong khai cua he thong ID ma TRINH DUYET nguoi choi toi duoc.
                            #   chua co domain: http://<PUBLIC_HOST>:8080   co domain: https://id.example.com
ID_PORT=8080
ID_DB_NAME=platform
ID_COOKIE_SECURE=false      # true khi ID_ISSUER la https
ID_SIGNING_KEY_PEM=         # RSA 2048 nhieu dong, trong ngoac kep, de CUOI file (gen-env.sh tu them; tay: printf 'ID_SIGNING_KEY_PEM="%s"\n' "$(openssl genrsa 2048)" >> .env)
ID_INTERNAL_SECRET=         # head -c 32 /dev/urandom | base64 — HMAC cho API nap tien noi bo (PHP callback -> vi ID); trong = tat
ID_WALLET_ENABLED=0         # 1 = callback the/bank/momo cong Xu vao vi ID thay vi web.user.xu (can ID_INTERNAL_SECRET)
# play.php hoi adapter de lay phien game san (khong bat nguoi choi dang nhap lai o client).
# De trong = tat: client quay ve man hinh dang nhap cu.
ADAPTER_BASE_URL=http://127.0.0.1:8090
ID_SMTP_HOST=               # trong = tat khoi phuc mat khau qua email
ID_SMTP_PORT=587
ID_SMTP_USER=
ID_SMTP_PASSWORD=
ID_SMTP_FROM=
ID_SMTP_FROM_NAME=Cổng game

ADAPTER_PORT=8090
ADAPTER_GAME_CODE=haitac
ADAPTER_GAME_ID=10091
ADAPTER_GAME_NAME=Đại Hải Trình   # ten hien thi (oauth_clients.name, games.name)
ADAPTER_CLIENT_ID=haitac
ADAPTER_CLIENT_SECRET=      # de trong = client cong khai (chi PKCE) — platform-seed tao oauth_clients voi secret_hash NULL
ADAPTER_REDIRECT_URI=       # http://<PUBLIC_HOST>/auth/callback (https://haitac.example.com/auth/callback khi co domain)
                            # platform-seed ghi dung gia tri nay vao oauth_clients.redirect_uris
ADAPTER_SITE_URL=           # trong = ADAPTER_REDIRECT_URI bo /auth/callback (games.site_url)
ADAPTER_SECRET_ENC_KEY=     # head -c 32 /dev/urandom | base64 — MOI GAME MOT KHOA RIENG
ADAPTER_CONSOLE_USER=admin  # tai khoan tcg.staff cua console :9999 (phat vat pham qua /gm/pay/*); mat khau = CONSOLE_ADMIN_PASSWORD
ADAPTER_CONSOLE_PAY_MODE=manual   # manual = /gm/pay/manual mot buoc; approval = createApproval + completeApproval
# platformCode gui cho login server. PHAI la `develop` voi ban JAR nay: do la ma duy nhat
# ma login server con bat nhanh dang nhap bang username+mat khau. Cac ma khac tra ve
# errorcode=0 nhung uid/token deu null kem ghi chu "该登录方式目前不生效" (cach dang nhap
# nay hien khong co hieu luc) — thanh cong gia, rat de tuong la loi o cho khac.
# Cung khop voi dong goc trong tcg.srv_game_access (platform_code='develop').
ADAPTER_PLATFORM_CODE=develop

# Domain that. De trong = chay theo IP (chi dung game.conf, khoi default_server).
# Dat vao thi lam theo docs/deploy-runbook.md muc "Tro domain that": xin chung chi
# TRUOC, dien __PUBLIC_DOMAIN__ vao docker/nginx/{domains,tls}.conf, roi mount chung.
PUBLIC_DOMAIN=
ADAPTER_CHANNEL_CODE=web
ADAPTER_TLS=false
ADAPTER_POLL_INTERVAL=10s
# Ve giu cho song toi da bao lau. Ve duoc NHA SOM khi heartbeat cua may chu tang len
# dung so nguoi da giu cho, nen gia tri nay chi la tran cho nguoi bam vao roi bo di.
# Dat ngan hon thoi gian tai client (~9,4 MB) se lam cong dem thieu dung luc dong nhat.
ADAPTER_TICKET_TTL=120s

ADMIN_ADDR=127.0.0.1:8100   # trang quan tri nen tang; mo bang  ssh -L 8100:127.0.0.1:8100 root@<server>  -> http://127.0.0.1:8100
ADMIN_COOKIE_SECURE=false
ADMIN_BOOTSTRAP_USER=       # tai khoan owner dau tien — chi tao khi bang admin_users con trong
ADMIN_BOOTSTRAP_PASSWORD=
