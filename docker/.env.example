# Copy thanh .env roi dien. KHONG commit .env (da gitignore).
# Dung cho CA HAI phuong an: docker-compose.yml (bind mount) va docker-compose.image.yml (pull image).

# ---------------------------------------------------------------- host cong khai
# IP hoac domain ma NGUOI CHOI truy cap (khong scheme). Duoc dien vao global.conf.json
# (server bao client dia chi login/stat/pay/world) va bundle client.
PUBLIC_HOST=

# ---------------------------------------------------------------- secrets server Java
# Phai KHOP voi du lieu trong dump MySQL/Mongo neu import tu server cu.
TCG_SECRET=                 # tcg.secret dung chung moi service (goc: env.yml)
MYSQL_ROOT_PASSWORD=
MONGO_USER=abc123
MONGO_PASSWORD=
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# ---------------------------------------------------------------- secrets website (PHP)
CONSOLE_ADMIN_PASSWORD=     # tai khoan admin console :9999 (gmhanglong/config/config.php)
WEB_DB_PASSWORD_REV=        # mat khau PDO rieng cua adminphp@2024/rev.php + user/indexapk.php (de trong = dung MYSQL_ROOT_PASSWORD)
THESIEUTOC_API_KEY=         # api/card.php
MOMO_CALLBACK_SIGNATURE=    # api/momoCallback.php
REV_QUERY_KEY=              # adminphp@2024/rev.php?key=
GM_CODE=                    # gm/config.php $gmcode
GMHANGLONG_CODE=            # gmhanglong/config/config.php $gm_code
GM_LOGIN_TOKEN=             # gm/user/function/common.php (JWT; lay moi qua POST /staff/login)
MOMO_PHONE=                 # so nhan MoMo trong link QR (user/naptien*.php)

# ---------------------------------------------------------------- duong dan / image
# Phuong an 1 (bind mount): cay server/ va website/ tren host
SERVER_DIR=../server
WEBSITE_DIR=../website
# Phuong an 2 (image): thu muc chua res/ sound/ spine/ (upload 1 lan bang WinSCP)
ASSETS_DIR=/opt/tcg/assets
IMAGE_SERVER=ghcr.io/rickymta/op-h5-server:latest
IMAGE_PHP=ghcr.io/rickymta/op-h5-php:latest
IMAGE_NGINX=ghcr.io/rickymta/op-h5-nginx:latest

# ---------------------------------------------------------------- game
GAME_SRV_CODE=s1

# ---------------------------------------------------------------- heap (may 8 GB; tong mac dinh 4992m)
JAVA_XMX_CONSOLE=512m
JAVA_XMX_WORLD=640m
JAVA_XMX_META=320m
JAVA_XMX_STATISTIC=512m
JAVA_XMX_PAY=384m
JAVA_XMX_GROUP=640m
JAVA_XMX_GAME=1024m
JAVA_XMX_LOGIN=320m
JAVA_XMX_CROSS=640m

# ---------------------------------------------------------------- doi game server
# srvCode:wsPort:deviceCode, cach nhau bang dau phay. HTTP noi bo cua moi tien trinh
# game LUON la wsPort + 10000, nen dung dat wsPort cua server nay trung HTTP cua server kia.
# Sua xong chay: ./gen-game-servers.sh --write
# Moi game server them ~1,2 GB RAM — may 8 GB chi vua MOT server cung ha tang.
GAME_SERVERS=s1:8001:host-01

# ---------------------------------------------------------------- nen tang (platform/)
ID_ISSUER=                  # URL cong khai cua he thong ID, vd https://id.example.com
ID_PORT=8080
ID_DB_NAME=platform
ID_COOKIE_SECURE=true       # dat false khi chay HTTP thuan luc dev
ID_SIGNING_KEY_PEM=         # openssl genrsa 2048   (dan ca khoi PEM vao day)

ADAPTER_PORT=8090
ADAPTER_GAME_CODE=haitac
ADAPTER_GAME_ID=10091
ADAPTER_CLIENT_ID=haitac
ADAPTER_CLIENT_SECRET=      # de trong neu dang ky client cong khai (chi PKCE)
ADAPTER_REDIRECT_URI=       # vd https://haitac.example.com/auth/callback — phai khop oauth_clients
ADAPTER_SECRET_ENC_KEY=     # head -c 32 /dev/urandom | base64
ADAPTER_TLS=false
ADAPTER_POLL_INTERVAL=10s
ADAPTER_TICKET_TTL=60s
