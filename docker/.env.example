# Copy thanh .env roi dien. KHONG commit .env.
#
# Mat khau phai KHOP voi cau hinh dang co trong server tree (chung khong duoc doc tu .env):
#   MYSQL_ROOT_PASSWORD  = mysqlConf.password  trong server/console/config/env.yml
#   MONGO_PASSWORD       = mongoConf.password  trong server/console/config/env.yml
#   RABBITMQ_PASSWORD    = stat.mq.password    trong server/console/store/global.conf.json
MYSQL_ROOT_PASSWORD=
MONGO_USER=abc123
MONGO_PASSWORD=
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# Duong dan tren host toi cay server/ va website/ (tuong doi so voi thu muc docker/)
SERVER_DIR=../server
WEBSITE_DIR=../website

# Game server code (bang tcg.srv_game). Moi game server them ~1.2 GB RAM.
GAME_SRV_CODE=s1

# Heap toi da tung service. Tong mac dinh = 4992m; may 8 GB con ~1.5 GB cho MySQL/Mongo/MQ/web.
# Tang neu thay "GC overhead limit exceeded" / OOM-killed trong `docker compose logs <svc>`.
JAVA_XMX_CONSOLE=512m
JAVA_XMX_WORLD=640m
JAVA_XMX_META=320m
JAVA_XMX_STATISTIC=512m
JAVA_XMX_PAY=384m
JAVA_XMX_GROUP=640m
JAVA_XMX_GAME=1024m
JAVA_XMX_LOGIN=320m
JAVA_XMX_CROSS=640m
